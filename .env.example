# 資料來源：mock（Mock Adapter + localStorage）或 http（HTTP Adapter）
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=/api/v1
VITE_STORE_SLUG=demo-snack
# true：顯示 Demo 面板與橫幅、啟用模擬器（mock 模式建議開啟）
VITE_DEMO_MODE=true
# 子路徑部署（例：GitHub Pages /zaiorderv2-Demo/）
VITE_APP_BASE_PATH=/
# browser 或 hash（無法設定 SPA fallback 的主機使用）
VITE_ROUTER_MODE=browser
# true：專用觸控面板部署（BR-36）
VITE_KIOSK_MODE=false
# GA4 衡量 ID；空值不載入
VITE_GA_ID=
